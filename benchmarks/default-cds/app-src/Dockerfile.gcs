FROM gcr.io/distroless/java25-debian13:latest
WORKDIR /app
COPY ext/ /app/
RUN ["java","-XX:+UseZGC","-XX:ArchiveClassesAtExit=/app/app-zgc.jsa","-Dspring.context.exit=onRefresh","-jar","/app/cdsdemo-0.0.1-SNAPSHOT.jar"]
RUN ["java","-XX:+UseG1GC","-XX:ArchiveClassesAtExit=/app/app-g1.jsa","-Dspring.context.exit=onRefresh","-jar","/app/cdsdemo-0.0.1-SNAPSHOT.jar"]
RUN ["java","-XX:+UseParallelGC","-XX:ArchiveClassesAtExit=/app/app-parallel.jsa","-Dspring.context.exit=onRefresh","-jar","/app/cdsdemo-0.0.1-SNAPSHOT.jar"]
RUN ["java","-XX:+UseSerialGC","-XX:ArchiveClassesAtExit=/app/app-serial.jsa","-Dspring.context.exit=onRefresh","-jar","/app/cdsdemo-0.0.1-SNAPSHOT.jar"]
